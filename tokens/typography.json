{
  "$schema": "https://schemas.ael.digital/tokens/typography.json",
  "meta": {
    "name": "AEL Typography Tokens",
    "version": "1.0.0",
    "source": "www.aymanelmasry.com",
    "extracted": "2026-07-18"
  },
  "fonts": {
    "primary": {
      "family": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
      "source": "Google Fonts",
      "weights": [300, 400, 500, 600, 700],
      "usage": "All UI text — body, headings, buttons, nav"
    },
    "mono": {
      "family": "'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', 'Courier New', monospace",
      "source": "System fonts",
      "usage": "Terminal, tags, badges, code blocks"
    }
  },
  "sizes": {
    "xs": { "rem": "0.75rem", "px": 12, "usage": "Small labels, meta" },
    "sm": { "rem": "0.8125rem", "px": 13, "usage": "Tags, badges, secondary text" },
    "base": { "rem": "0.9375rem", "px": 15, "usage": "Body text" },
    "lg": { "rem": "1.125rem", "px": 18, "usage": "Large body, card text" },
    "xl": { "rem": "1.25rem", "px": 20, "usage": "Subheadings" },
    "2xl": { "rem": "1.5rem", "px": 24, "usage": "Section headings" },
    "3xl": { "rem": "2rem", "px": 32, "usage": "Major headings" },
    "4xl": { "rem": "2.5rem", "px": 40, "usage": "Hero heading" }
  },
  "weights": {
    "light": 300,
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "line-heights": {
    "body": 1.6,
    "heading": 1.2,
    "small": 1.4
  },
  "usage": {
    "hero-heading": { "size": "4xl", "weight": 300, "line-height": 1.2, "transform": "gradient-text" },
    "section-title": { "size": "3xl", "weight": 300, "line-height": 1.2 },
    "card-title": { "size": "lg", "weight": 600, "line-height": 1.3 },
    "body": { "size": "base", "weight": 400, "line-height": 1.6, "color": "#E6EEF8" },
    "secondary": { "size": "sm", "weight": 400, "color": "#8899AA" },
    "tag": { "size": "xs", "weight": 500, "family": "mono" },
    "nav-link": { "size": "sm", "weight": 500 },
    "button": { "size": "sm", "weight": 600 }
  }
}
